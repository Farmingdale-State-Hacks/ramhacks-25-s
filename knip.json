{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "app/client.tsx",
    "app/ssr.tsx",
    "app/router.tsx",
    "app.config.ts",
    "app/routes/**/*.{ts,tsx}"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}"
  ],
  "rules": {
    "files": "off",
    "dependencies": "off",
    "devDependencies": "off",
    "unlisted": "off",
    "exports": "off",
    "types": "off",
    "enumMembers": "off",
    "duplicates": "off"
  }
}
